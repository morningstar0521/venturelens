# ── VentureLens environment template ─────────────────────────────────────────
# Copy this to `.env` and fill in real values:   cp .env.example .env

# ── Required ─────────────────────────────────────────────────────────────────
# Neon Postgres connection string. For Next.js / Vercel, use the
# *pooler* (Serverless) connection URL, not the direct editor URL.
DATABASE_URL=neon:postgres://user:password@ep-host-pooler.region.aws.neon.tech/dbname?sslmode=require

# NextAuth encryption secret (32+ characters). Generate with:
#   openssl rand -base64 32
AUTH_SECRET=

# Canonical URL of the app. Must match the host exactly (scheme + port + path).
NEXTAUTH_URL=http://localhost:3000

# ── AI providers (optional — app works without these) ────────────────────────
# Without either key, evaluation & team-building fall back to the built-in
# rule-based engine.
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Seeded admin (used by GET /api/db/seed-admin) ────────────────────────────
# Strong defaults are baked in for dev; override for anything real.
ADMIN_EMAIL=admin@venturelens.ai
ADMIN_PASSWORD=Admin@VL2024!

# ── Neon Object Storage (S3-compatible) ──────────────────────────────────────
# Optional: if omitted, resumes are safely stored in Postgres as Base64 with 2MB validation
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
RESUMES_BUCKET=resume-venturelens-01

